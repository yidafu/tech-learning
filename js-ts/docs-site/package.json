{
  "name": "js-ts-notes-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node scripts/gen-ts-libs.mjs && docusaurus start --port 3004 --no-open",
    "build": "node scripts/gen-ts-libs.mjs && docusaurus build",
    "build:analyze": "node scripts/gen-ts-libs.mjs && RSDOCTOR=true docusaurus build",
    "serve": "docusaurus serve --port 3004",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-rsdoctor": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-live-codeblock": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.1.0",
    "docusaurus-graph": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@types/react": "^18.3.3",
    "patch-package": "^8.0.0",
    "typescript": "~5.6.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome versions",
      "last 3 firefox versions",
      "last 5 safari versions"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
